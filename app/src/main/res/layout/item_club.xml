<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="160dp"
    android:layout_height="210dp"
    android:layout_margin="8dp"
    android:focusable="true"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#FFFFFF"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp">

        <!-- Image avec cercle de fond -->
        <FrameLayout
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:background="@drawable/bg_circle">

            <ImageView
                android:id="@+id/imgClub"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:src="@drawable/robotique"
                android:contentDescription="Club image" />

        </FrameLayout>

        <!-- Nom du club -->
        <TextView
            android:id="@+id/txtClubName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Club Name"
            android:textColor="#1E3A8A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:gravity="center"/>

        <!-- Bouton Rejoindre/Quitter (pour utilisateurs) -->
        <Button
            android:id="@+id/btnJoin"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:text="Rejoindre"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_rounded"
            android:visibility="visible"/>

        <!-- Layout pour les boutons Admin (Modifier/Supprimer) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnEditClub"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="Modifier"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_edit"
                android:layout_marginEnd="4dp"
                android:visibility="gone"/>

            <Button
                android:id="@+id/btnDeleteClub"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="Supprimer"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_delete"
                android:layout_marginStart="4dp"
                android:visibility="gone"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
